# Salin file ini menjadi .env.local lalu isi dengan kredensial project Supabase Anda.
# Kedua nilai ini aman dipakai di browser (anon key memang untuk publik),
# keamanan data diatur oleh Row Level Security di supabase/schema.sql.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Tanpa dua variabel di atas, aplikasi tetap berjalan penuh dalam mode lokal
# (data disimpan di perangkat lewat IndexedDB).
